\begin_layout Plain Layout
Formulation to obtain the exact solution for this setup:
\end_layout

\begin_layout Plain Layout
minimise:
\end_layout

\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
z= & \sum_{t}\sum_{s}p^{other\_operational\_costs}_{cheap\_source,t,s}\cdot p^{weight}_{cheap\_source,s}\cdot v^{flow}_{cheap\_source,t,s}+p^{other\_operational\_costs}_{expensive\_source,t,s}\cdot v^{flow}_{expensive\_source,t,s}
\end{align*}

\end_inset


\end_layout

\begin_layout Plain Layout
subject to:
\end_layout

\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
p^{flow\_profile}_{demand,t,s}= & v^{flow}_{cheap\_link,out,t,s}+v^{flow}_{expensive\_link,out,t,s}\\
v^{flow}_{cheap\_link,out,t,s}= & p^{efficiency}_{cheap\_link}\cdot v^{flow}_{cheap\_link,in,t,s}\\
